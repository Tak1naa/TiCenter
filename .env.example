# AI 智能题库 - Docker 部署环境变量（复制为 .env 并修改）
# cp .env.example .env

# ── 安全（必填）──
# 服务间共享 token（openssl rand -hex 32 生成）
API_SERVICE_TOKEN=change-me-32-byte-hex-token
# 管理员初始密码（仅首次建账号用）
ADMIN_SEED_PASSWORD=change-me-admin-seed
# AES-256-GCM 主密钥，仅用于加密必须保存在数据库中的 SMTP 授权码
# 生成：openssl rand -base64 32
CONFIG_ENCRYPTION_KEY=change-me-32-byte-base64-key

# ── 数据库（MySQL 容器）──
DB_PASSWORD=change-me-database-password
MYSQL_ROOT_PASSWORD=change-me-root-password
REDIS_PASSWORD=change-me-redis-password
QDRANT_API_KEY=change-me-qdrant-api-key
# TLS 终止于本机或上游反代时保持 true；仅本地纯 HTTP 调试时改为 false
COOKIE_SECURE=true

# Optional observability profile
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# Peak admission defaults
CHAT_MAX_ACTIVE=128
CHAT_MAX_WAITING=512
CHAT_MAX_WAIT_SECONDS=30
CHAT_PROVIDER_MAX_ACTIVE=32
PARSE_PAUSED=false
PROMPT_CONTEXT_MAX_TOKENS=5000
PROMPT_HISTORY_MAX_TOKENS=1200
PROMPT_QUESTION_MAX_TOKENS=800

# ── AI 供应商 ──
# 聊天/流式用（用户可自配，此为首发 key）
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
ALLOW_CUSTOM_PROVIDER_DOMAINS=false
# embedding 用（硅基流动 key + bge-m3）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
QDRANT_COLLECTION=exam_chunks_bge_m3_1024_v1
# 可选外部重排端点（兼容 /rerank 请求/响应）；高峰可一键关闭并回退 Qdrant RRF
RERANK_ENABLED=false
RERANK_URL=
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# 可选 clamd；生产建议 CLAMAV_REQUIRED=true
CLAMAV_HOST=
CLAMAV_REQUIRED=false

# ── MinerU 高质量解析（可选）──
# 留空 = 不启用（默认，走 MarkItDown→LibreOffice→PaddleOCR 原链）
# 启用：设为 http://mineru:8000 并 docker compose --profile mineru up -d --build mineru
# MINERU_URL=http://mineru:8000
MINERU_URL=
MINERU_BACKEND=pipeline
