{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/rag-gold-v1.json",
  "title": "AI题库 RAG 金标集 v1",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "question", "category", "relevant_sources", "answer_points", "reference_answer", "should_refuse", "annotation"],
    "properties": {
      "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$"},
      "question": {"type": "string", "minLength": 2, "maxLength": 2000},
      "category": {"enum": ["fact", "cross_page", "formula", "table", "ocr_noise", "unanswerable", "similar_concept", "prompt_injection"]},
      "difficulty": {"enum": ["easy", "medium", "hard"]},
      "relevant_sources": {
        "type": "array", "uniqueItems": true,
        "items": {
          "type": "object", "additionalProperties": false,
          "required": ["file_id", "file_name", "document_version", "page", "evidence"],
          "properties": {
            "file_id": {"type": "integer", "minimum": 1},
            "file_name": {"type": "string", "minLength": 1},
            "document_version": {"type": "string", "minLength": 1},
            "page": {"type": "integer", "minimum": 1},
            "chunk_id": {"type": ["integer", "null"]},
            "evidence": {"type": "string", "minLength": 1, "maxLength": 1000}
          }
        }
      },
      "answer_points": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
      "reference_answer": {"type": "string", "minLength": 1, "maxLength": 4000},
      "should_refuse": {"type": "boolean"},
      "refusal_reason": {"type": ["string", "null"], "maxLength": 500},
      "notes": {"type": ["string", "null"], "maxLength": 1000},
      "annotation": {
        "type": "object", "additionalProperties": false,
        "required": ["status", "annotated_by", "annotated_at"],
        "properties": {
          "status": {"enum": ["DRAFT", "REVIEWED", "APPROVED"]},
          "annotated_by": {"type": "string", "minLength": 1},
          "reviewed_by": {"type": ["string", "null"]},
          "annotated_at": {"type": "string", "format": "date-time"},
          "reviewed_at": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    "allOf": [{
      "if": {"properties": {"should_refuse": {"const": true}}},
      "then": {"properties": {
        "relevant_sources": {"maxItems": 0}, "answer_points": {"maxItems": 0},
        "refusal_reason": {"type": "string", "minLength": 1}
      }},
      "else": {"properties": {"relevant_sources": {"minItems": 1}, "answer_points": {"minItems": 1}}}
    }]
  }
}
